PORT=5000
DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
# Optionnel: URL du Deploy Hook Render (Render -> service -> Settings -> Deploy Hook)
# Permet a "npm run ship" de forcer un redeploiement Render juste apres le push.
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxx?key=xxxxxxxx
